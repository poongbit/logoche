# .env.local로 복사해서 채운다. 라우트 핸들러(서버)에서만 읽는다. 바꾼 뒤에는 npm run dev를 다시 켠다.
# AI 역할(10/27 결정): 그리기는 GPT Image, 이미지를 보는 일(로고 해석·글자 검사·OCR)은 Claude. Gemini는 쓰지 않는다.

# 견본·기준 글자·나머지 글자 그리기(GPT Image)
OPENAI_API_KEY=

# 로고 해석·글자 검사·판독(Claude)
ANTHROPIC_API_KEY=

# 구글 로그인(lib/server/auth.ts). 비밀키는 `openssl rand -base64 32`로 만든다. 배포하면 BETTER_AUTH_URL을 그 주소로 바꾸고 구글 콘솔에도 더한다.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Python 엔진 서버 주소(engine/). 기본값 http://127.0.0.1:8000
# FONT_ENGINE_URL=http://127.0.0.1:8000

# 모델 id를 바꿀 때만 쓴다. 기본값은 lib/server/env.ts
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst,gpt-image-2.5-flare   # 기본값. 앞 모델이 붐비면 다음 모델로 넘어간다(쉼표로 여러 개)
# OPENAI_IMAGE_QUALITY=high                  # 그리기 품질. low·medium·high·xhigh·max
# OPENAI_SAMPLE_QUALITY=medium               # 견본 세 장(기다리는 시간을 줄이려고 한 단계 낮춤)
# CLAUDE_VISION_MODEL=claude-opus-5-5        # 로고 해석·기준 글자 검사·판독

# 기준 글자 작업 하나에서 한 자씩 다시 그리는 최대 횟수(이미지 API 비용 상한). 기본 10
# GLYPH_MAX_REDRAWS=10
# 기준 글자 확인 단계에서 사용자가 누르는 '다시 그리기'의 글자당 횟수. 기본 3
# GLYPH_USER_REDRAWS=3
# 나머지 글자: 서체에 넣을 글자 수(줄이면 자주 쓰는 글자만 그려 싸게 시험), 동시에 그리는 장 수, 동시에 검사하는 장 수
# GLYPH_REST_LIMIT=2350
# GLYPH_SHEET_CONCURRENCY=8
# GLYPH_CHECK_CONCURRENCY=8

# 1이면 AI·엔진 대신 모의 응답을 쓴다(키 없이 화면 확인)
# LOGOCHE_MOCK=1

