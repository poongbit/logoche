# .env.local로 복사해서 채운다. 라우트 핸들러(서버)에서만 읽는다. 바꾼 뒤에는 npm run dev를 다시 켠다.
# AI 역할(10/27 결정): 그리기는 GPT Image, 이미지를 보는 일(로고 해석·글자 검사·OCR)은 Claude. Gemini는 쓰지 않는다.

# 견본·참고 글자·나머지 글자 그리기(GPT Image)
OPENAI_API_KEY=

# 로고 해석·글자 검사·OCR(Claude)
ANTHROPIC_API_KEY=

# Python 엔진 서버 주소(engine/). 기본값 http://127.0.0.1:8000
# FONT_ENGINE_URL=http://127.0.0.1:8000

# 모델 id를 바꿀 때만 쓴다. 기본값은 lib/server/env.ts
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare     # 편집 정밀도를 더 보려면 gpt-image-2.5-sunburst(더 느림). 쉼표로 여러 개
# OPENAI_IMAGE_QUALITY=high                  # 참고 글자표. low·medium·high·xhigh·max
# OPENAI_SAMPLE_QUALITY=medium               # 화면 2 표현 방식 견본(세 장을 기다리므로 한 단계 낮춤)
# CLAUDE_VISION_MODEL=claude-opus-5-5        # 로고 해석·참고 글자 검사·OCR

# 참고 글자 작업 하나에서 한 자씩 다시 그리는 최대 횟수(이미지 API 비용 상한). 기본 10
# GLYPH_MAX_REDRAWS=10
# 화면 3 글자 카드에서 사용자가 누르는 '다시 그리기'의 글자당 횟수. 기본 3
# GLYPH_USER_REDRAWS=3
# 화면 4 나머지 글자(10/30): 서체에 넣을 글자 수(줄이면 자주 쓰는 글자만 그려 싸게 시험), 동시에 그리는 장 수, 동시에 검사하는 장 수
# GLYPH_REST_LIMIT=2350
# GLYPH_SHEET_CONCURRENCY=8
# GLYPH_CHECK_CONCURRENCY=8

# 1이면 AI·엔진 대신 모의 응답을 쓴다(키 없이 화면 확인)
# LOGOCHE_MOCK=1

